# Motionbase Environment Configuration Example
# Copy to .env.local for local overrides. Do NOT commit private keys.

NEXT_PUBLIC_APP_NAME="Motionbase"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ENABLE_MOCK_STORAGE="true"

# Optional Supabase Integration (falls back gracefully to memory/mock repository)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
